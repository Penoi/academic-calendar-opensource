# Sem DATABASE_URL, o app usa SQLite local (./calendar.db) — bom para desenvolvimento.
# Produção (Neon/Supabase): cole a URL do painel como está; o app converte para asyncpg sozinho.
#   DATABASE_URL=postgresql://user:senha@ep-xxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL=sqlite+aiosqlite:///./calendar.db
SECRET_KEY=troque-isto
COOKIE_SECURE=false
TIMEZONE=America/Sao_Paulo
